#!/usr/bin/env bash
# Block commits containing anything shaped like a credential.
#
# The constitution says no keys, tokens or real personal data enter this
# repository at any point INCLUDING COMMIT HISTORY. History is the hard part:
# a key removed in a later commit is still in the repo forever. So this refuses
# the commit rather than trusting anyone to notice.
set -euo pipefail

PATTERNS='sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|ghp_[A-Za-z0-9]{36}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

if git diff --cached --name-only -z | xargs -0 -I{} sh -c 'test -f "{}" && git show ":{}"' 2>/dev/null \
   | grep -nEq "$PATTERNS"; then
  echo "BLOCKED: a staged file matches a credential pattern." >&2
  echo "Nothing was committed. If this is a false positive, inspect it first —" >&2
  echo "a key in git history cannot be removed by a later commit." >&2
  exit 1
fi

if git diff --cached --name-only | grep -qE '^\.secrets/(?!README|env\.example)'; then
  echo "BLOCKED: attempting to commit a file under .secrets/." >&2
  exit 1
fi
